{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "story-chain",
  "type": "object",
  "required": [
    "id",
    "sequence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "openingEntries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "closingEntries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "archiveAssignment": {
      "type": "string",
      "minLength": 1
    },
    "characterReveals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "characterCompletion": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unlocks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
