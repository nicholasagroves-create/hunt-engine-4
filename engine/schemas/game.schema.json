{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "schemaVersion",
    "content"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "skinId": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "onboarding": {
      "type": "object"
    },
    "tutorial": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "enum": [
                  "puzzle",
                  "instruction"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "allowReplay": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ],
            "properties": {
              "steps": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "transmissionSettings": {
      "type": "object"
    },
    "completionRules": {
      "type": "object"
    },
    "paymentSettings": {
      "type": "object"
    },
    "content": {
      "type": "object",
      "required": [
        "puzzles",
        "storyChains",
        "characters",
        "journals",
        "inventory",
        "transmissions",
        "achievements",
        "skins",
        "openingScreens"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "openingSequence": {
      "type": "object",
      "required": [
        "screenIds"
      ],
      "properties": {
        "screenIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowNarrativeReplay": {
          "type": "boolean"
        },
        "studioDefaultId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "launch": {
      "type": "object",
      "properties": {
        "initialDestination": {
          "type": "string",
          "minLength": 1
        },
        "initialQrPolicy": {
          "enum": [
            "require-rescan",
            "auto-launch",
            "ignore"
          ]
        },
        "rescanPrompt": {
          "type": "object"
        },
        "resumePolicy": {
          "enum": [
            "last-meaningful-screen",
            "default"
          ]
        },
        "archive": {
          "type": "object",
          "properties": {
            "initialCharacter": {
              "enum": [
                "latest-tile",
                "default"
              ]
            },
            "afterPuzzle": {
              "enum": [
                "tile-recipient",
                "default"
              ]
            },
            "manualOpen": {
              "enum": [
                "last-viewed",
                "default"
              ]
            },
            "defaultCharacterId": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
