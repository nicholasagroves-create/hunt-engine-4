{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "schemaVersion",
    "content"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "skinId": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "onboarding": {
      "type": "object"
    },
    "tutorial": {
      "type": "object"
    },
    "transmissionSettings": {
      "type": "object"
    },
    "completionRules": {
      "type": "object"
    },
    "paymentSettings": {
      "type": "object"
    },
    "content": {
      "type": "object",
      "required": [
        "puzzles",
        "storyChains",
        "characters",
        "journals",
        "inventory",
        "transmissions",
        "achievements",
        "skins"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
