{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "achievement",
  "type": "object",
  "required": [
    "id",
    "name",
    "conditions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "conditions": {
      "type": "object"
    },
    "visibility": {
      "enum": [
        "visible",
        "hidden",
        "partial"
      ]
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "presentation": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
