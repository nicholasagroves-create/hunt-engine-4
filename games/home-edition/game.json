{
  "id": "home-edition",
  "name": "Hunt: Home Edition",
  "version": 1,
  "schemaVersion": 1,
  "skinId": "home-default",
  "modules": {
    "qr": true,
    "characters": true,
    "journal": true,
    "inventory": true,
    "transmissions": true,
    "finale": true,
    "achievements": true
  },
  "onboarding": {
    "enabled": true
  },
  "tutorial": {
    "enabled": true,
    "steps": [
      {
        "type": "puzzle",
        "id": "dev-compass-tutorial"
      }
    ],
    "allowReplay": true
  },
  "transmissionSettings": {
    "maxActive": 2
  },
  "paymentSettings": {
    "required": false
  },
  "content": {
    "puzzles": "content/puzzles.json",
    "storyChains": "content/storyChains.json",
    "characters": "content/characters.json",
    "journals": "content/journals.json",
    "inventory": "content/inventory.json",
    "transmissions": "content/transmissions.json",
    "achievements": "content/achievements.json",
    "skins": "content/skins.json",
    "openingScreens": "content/openingScreens.json"
  },
  "openingSequence": {
    "screenIds": [
      "dev-access",
      "dev-studio",
      "dev-sponsor",
      "dev-title",
      "dev-narrative"
    ],
    "allowNarrativeReplay": true
  },
  "launch": {
    "initialQrPolicy": "require-rescan",
    "resumePolicy": "last-meaningful-screen"
  },
  "navigation": [
    {
      "id": "archive",
      "label": "Archive",
      "icon": "▦"
    },
    {
      "id": "scan",
      "label": "Scan",
      "icon": "⌾",
      "prominent": true
    },
    {
      "id": "transmissions",
      "label": "Messages",
      "icon": "✉",
      "module": "transmissions"
    },
    {
      "id": "finale",
      "label": "Finale",
      "icon": "✦",
      "module": "finale"
    }
  ],
  "archiveTabs": [
    {
      "id": "characters",
      "label": "Characters",
      "layout": "characters",
      "module": "characters"
    },
    {
      "id": "journal",
      "label": "Journal",
      "layout": "journal",
      "module": "journal"
    },
    {
      "id": "inventory",
      "label": "Inventory",
      "layout": "inventory",
      "module": "inventory"
    }
  ],
  "shell": {
    "transition": "fade"
  }
}